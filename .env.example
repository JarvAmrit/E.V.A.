# E.V.A. Environment Variables
# Copy this file to .env and fill in your values.

# ── Required ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── Wake word (Picovoice – free at https://picovoice.ai) ─────────────────
PICOVOICE_ACCESS_KEY=

# ── TTS: "pyttsx3" (local, no key) or "elevenlabs" (cloud) ───────────────
TTS_BACKEND=pyttsx3
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── Web search: leave blank to use free DuckDuckGo fallback ──────────────
BING_SEARCH_API_KEY=

# ── Model / performance tuning ───────────────────────────────────────────
OPENAI_MODEL=gpt-4o
WHISPER_MODEL=base.en

# ── Audio sensitivity ─────────────────────────────────────────────────────
SILENCE_THRESHOLD=0.01
SILENCE_DURATION=1.5

# ── WebSocket server ──────────────────────────────────────────────────────
WS_HOST=localhost
WS_PORT=8765
